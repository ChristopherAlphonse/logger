{
  "name": "@calphonse/logger",
  "version": "1.1.1-canary.3",
  "description": "Colored logging utility with chalk for Node.js applications",
  "author": "Christopher Alphonse",
  "homepage": "https://github.com/ChristopherAlphonse/logger",
  "repository": "github:ChristopherAlphonse/logger",
  "license": "MIT",
  "keywords": [
    "logger",
    "logging",
    "chalk",
    "colors",
    "console",
    "utility"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:node": "tsc && node --test --test-reporter=spec dist/**/*.test.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "biome:fix-and-check": "biome check . --fix && biome check .",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "prepare": "pnpm build",
    "quality": "pnpm lint && pnpm format && pnpm test",
    "quality:fix": "pnpm lint:fix && pnpm format && pnpm test",
    "quality:biome": "pnpm biome:fix-and-check && pnpm test",
    "prepublishOnly": "pnpm quality && pnpm build",
    "validate": "pnpm quality && pnpm build",
    "ci": "pnpm quality",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "example:basic": "tsx examples/basic-usage.ts",
    "example:error": "tsx examples/error-handling-demo.ts",
    "test:enhanced": "node test-string-contexts.js",
    "test:colors": "node test-colors.js",
    "test:table": "node test-table.js",
    "test:bordered": "node test-bordered-table.js",
    "test:clean": "node test-clean-table.js",
    "test:bordered-final": "node test-bordered-table-final.js",
    "demo": "tsx examples/demo.ts",
    "test:colors": "node test-colored-contexts.js",
    "test:spacing": "node test-spacing.js",
    "publish-package": "pnpm publish --access public",
    "publish-package-canary": "pnpm publish --tag canary --access public"
  },
  "dependencies": {
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.8.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "tslib": "^2.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.0.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.es.js"
    }
  }
}
